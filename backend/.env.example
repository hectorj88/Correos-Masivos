
# Correo utilizado para el certificado SSL de Let's Encrypt (ACME)
ACME_EMAIL=usuario@micorreo.com

# --- Entorno ---
# "development" habilita /docs; en producción déjalo en production
APP_ENV=production

# --- PostgreSQL (usa contraseña alfanumérica: openssl rand -hex 24) ---
POSTGRES_USER=tracking_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=tracking
# DATABASE_URL solo si corres la API fuera de Docker:
# DATABASE_URL=postgresql+asyncpg://tracking_user:CAMBIA_ESTA_CLAVE@localhost:5432/tracking

# --- Seguridad ---
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=
# Dominio(s) públicos permitidos (formato JSON). Recomendado: un subdominio dedicado al tracking
ALLOWED_HOSTS=["track.midominioweb.com"]

# --- Privacidad / comportamiento ---
# true para guardar la IP de quien abre
STORE_IP=false
# Ignora aperturas repetidas del mismo correo dentro de esta ventana (segundos)
DEDUPE_SECONDS=30
